# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# PostgreSQL connection string. Hosted databases usually need ?sslmode=require at the end.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Random string used to sign session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# OpenAI
OPENAI_API_KEY=
# Optional. Must support PDF/image input. Defaults to gpt-4o.
OPENAI_MODEL=gpt-4o

# Gmail SMTP: your address plus a Google "App password" (needs 2-Step Verification)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Cloudinary: copy the "API environment variable" from your Cloudinary dashboard
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
